 "frames": 2987,
 "cutA07A08": 41.08,
 "lines": [
  {
   "id": "L1",
   "who": "n",
   "text": "Jam dua pagi, kamu terbangun karena pengeras suara kompleks.",
   "start": 0.5,
   "end": 4.421
  },
  {
   "id": "L2",
   "who": "toa",
   "text": "“Seluruh warga diminta keluar rumah.”",
   "start": 5.121,
   "end": 7.48
  },
  {
   "id": "L3",
   "who": "n",
   "text": "Kamu langsung duduk.",
   "start": 8.72,
   "end": 9.785
  },
  {
   "id": "L4",
   "who": "n",
   "text": "Itu suaramu.",
   "start": 10.133,
   "end": 10.949
  },
  {
   "id": "L5",
   "who": "n",
   "text": "Intonasinya, cara menarik napas, bahkan suara serak di ujung kalimatnya.",
   "start": 11.225,
   "end": 15.981
  },
  {
   "id": "L6",
   "who": "n",
   "text": "Dari jendela, kamu melihat tetangga mulai keluar.",
   "start": 16.323,
   "end": 19.174
  },
  {
   "id": "L7",
   "who": "n",
   "text": "Ada yang masih memakai sarung.",
   "start": 19.436,
   "end": 20.957
  },
  {
   "id": "L8",
   "who": "n",
   "text": "Ada yang menggendong anaknya.",
   "start": 21.16,
   "end": 22.626
  },
  {
   "id": "L9",
   "who": "n",
   "text": "Adikmu muncul di pintu kamar sambil membawa jaket.",
   "start": 22.888,
   "end": 25.617
  },
  {
   "id": "L10",
   "who": "adik",
   "text": "“Kita ikut, kan?”",
   "start": 26.482,
   "end": 27.325
  },
  {
   "id": "L11",
   "who": "n",
   "text": "Kamu mengambil ponsel.",
   "start": 28.125,
   "end": 29.452
  },
  {
   "id": "L12",
   "who": "n",
   "text": "Grup warga penuh pertanyaan.",
   "start": 29.837,
   "end": 31.74
  },
  {
   "id": "L13",
   "who": "n",
   "text": "Lalu masuk pesan dari petugas keamanan.",
   "start": 32.09,
   "end": 34.68
  },
  {
   "id": "L14",
   "who": "msg",
   "text": "“Jangan keluar dulu.",
   "start": 35.18,
   "end": 36.187
  },
  {
   "id": "L15",
   "who": "msg",
   "text": "Ruang pengeras suara terkunci.",
   "start": 36.591,
   "end": 38.239
  },
  {
   "id": "L16",
   "who": "msg",
   "text": "Kuncinya masih saya bawa.”",
   "start": 38.531,
   "end": 40.103
  },
  {
   "id": "L17",
   "who": "n",
   "text": "Kamu menarik adikmu menjauh dari pintu.",
   "start": 41.148,
   "end": 43.173
  },
  {
   "id": "L18",
   "who": "n",
   "text": "Pengumuman itu berhenti.",
   "start": 43.557,
   "end": 44.913
  },
  {
   "id": "L19",
   "who": "n",
   "text": "Beberapa detik kemudian, suaramu terdengar lagi.",
   "start": 46.913,
   "end": 49.611
  },
  {
   "id": "L20",
   "who": "toa",
   "text": "“Keluarga di rumah nomor tujuh.",
   "start": 50.311,
   "end": 52.938
  },
  {
   "id": "L21",
   "who": "toa",
   "text": "Kami masih menunggu.”",
   "start": 53.506,
   "end": 55.006
  },
  {
   "id": "L22",
   "who": "n",
   "text": "Nomor rumahmu.",
   "start": 56.306,
   "end": 58.425
  },
  {
   "id": "L23",
   "who": "n",
   "text": "Adikmu menatapmu.",
   "start": 59.06,
   "end": 60.418
  },
  {
   "id": "L24",
   "who": "adik",
   "text": "“Kok dia tahu?”",
   "start": 61.018,
   "end": 62.37
  },
  {
   "id": "L25",
   "who": "n",
   "text": "Kamu mematikan lampu ruang tamu.",
   "start": 63.37,
   "end": 65.422
  },
  {
   "id": "L26",
   "who": "n",
   "text": "Pengeras suara kembali berbunyi.",
   "start": 65.943,
   "end": 67.753
  },
  {
   "id": "L27",
   "who": "toa",
   "text": "“Mematikan lampu tidak berarti rumahnya kosong.”",
   "start": 68.653,
   "end": 72.591
  },
  {
   "id": "L28",
   "who": "n",
   "text": "Di luar, tetangga yang tadi berjalan mulai berhenti.",
   "start": 74.091,
   "end": 77.349
  },
  {
   "id": "L29",
   "who": "n",
   "text": "Satu per satu, mereka menoleh ke rumahmu.",
   "start": 77.874,
   "end": 80.515
  },
  {
   "id": "L30",
   "who": "n",
   "text": "Adikmu menggenggam tanganmu semakin erat.",
   "start": 80.982,
   "end": 83.031
  },
  {
   "id": "L31",
   "who": "n",
   "text": "Pintu belakang mengarah ke gang sempit.",
   "start": 83.457,
   "end": 85.468
  },
  {
   "id": "L32",
   "who": "n",
   "text": "Tapi dari tempatmu berdiri, kamu tidak bisa melihat siapa yang ada di sana.",
   "start": 85.703,
   "end": 89.669
  },
  {
   "id": "L33",
   "who": "n",
   "text": "Kamu akan tetap di dalam dan menunggu petugas keamanan, atau membawa adikmu keluar lewat belakang sebelum orang-orang itu mendekat?",
   "start": 90.102,
   "end": 96.563
  }
 ],
